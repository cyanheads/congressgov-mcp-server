# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max inbound request-body size in bytes (default: 1 MiB; 0 = disable)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)
# MCP_REQUEST_STATE_KEY=            # Opt-in, >= 32 bytes, same on every instance; seals handler requestState

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateless        # auto | stateful | stateless; this server declares stateless when unset.
# MCP_HTTP_RESUMABILITY=false       # SSE replay kill switch; no effect on stateless serving (default: true)
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per stateful session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # Replay retention in milliseconds

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval in milliseconds (Bun only)

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_LLM_INTERACTIONS=false         # Log LLM interaction records (default: false)
# LOG_TOOL_FAILURE_PAYLOADS=false            # Log failed-call input/output with key-based redaction
# Redaction does not remove secrets embedded in free-form values.
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Maximum bytes per input/output payload

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base endpoint for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base endpoint for metrics; used as-is
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Explicit logs endpoint; base endpoint enables only traces/metrics

# ── Server-specific ──────────────────────────────────────────────────
# CONGRESS_API_KEY=                     # Optional — free key from https://api.data.gov/signup/ (5000 req/hr). Omit to use DEMO_KEY (30 req/hr).
# CONGRESS_API_BASE_URL=https://api.congress.gov/v3  # Congress.gov API base URL

# ── Bill search mirror (optional; disabled by default) ───────────────
# Local FTS mirror of bill titles + CRS summaries backing congressgov_search_bills.
# Build the index out-of-band with `bun run mirror:init` before the tool returns results.
# CONGRESS_MIRROR_ENABLED=false                   # Enable the mirror + the congressgov_search_bills tool
# CONGRESS_MIRROR_PATH=.mirror/bills.sqlite3      # SQLite mirror index path
# CONGRESS_MIRROR_REFRESH_CRON=                   # Cron for the in-process refresh (HTTP transport only); unset = run `mirror:refresh` manually
# CONGRESS_MIRROR_CONGRESSES=                     # Comma-separated congresses to mirror (default: current + 1 prior, e.g. 118,119)
