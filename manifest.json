{
  "manifest_version": "0.3",
  "name": "congressgov-mcp-server",
  "version": "0.9.0",
  "description": "Access U.S. congressional data (bills, votes, members, committees) via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/congressgov-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/congressgov-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "CONGRESS_API_KEY": "${user_config.CONGRESS_API_KEY}"
      }
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "CONGRESS_API_KEY": {
      "type": "string",
      "title": "Congress.gov API Key",
      "description": "Optional. Fallbacks: DEMO_KEY 30/hour and 50/day per IP; registered key from api.data.gov 5,000/hour. Upstream hourly quota headers take precedence.",
      "required": false,
      "default": ""
    }
  }
}
