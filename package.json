{
  "name": "@cyanheads/congressgov-mcp-server",
  "version": "0.10.0",
  "description": "Access U.S. congressional data (bills, votes, members, committees) via MCP. STDIO or Streamable HTTP.",
  "mcpName": "io.github.cyanheads/congressgov-mcp-server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "congressgov-mcp-server": "dist/index.js"
  },
  "files": [
    "changelog/",
    "skills/",
    "dist/",
    "!dist/*.mcpb",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "AGENTS.md",
    "Dockerfile",
    "server.json"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "rebuild": "bun scripts/clean.ts && bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "devcheck": "bun scripts/devcheck.ts",
    "audit:fix": "bun audit fix",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "tree": "bun scripts/tree.ts",
    "list-skills": "bun scripts/list-skills.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun scripts/lint-mcp.ts",
    "lint:packaging": "bun scripts/lint-packaging.ts",
    "bundle": "bun run build && npx -y @anthropic-ai/mcpb pack . dist/congressgov-mcp-server.mcpb && bun scripts/clean-mcpb.ts dist/congressgov-mcp-server.mcpb",
    "changelog:build": "bun scripts/build-changelog.ts",
    "changelog:check": "bun scripts/build-changelog.ts --check",
    "test": "vitest run",
    "release:github": "bun scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "dev:stdio": "MCP_TRANSPORT_TYPE=stdio bun --watch src/index.ts",
    "dev:http": "MCP_TRANSPORT_TYPE=http bun --watch src/index.ts",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js",
    "mirror:init": "bun dist/cli/mirror-init.js",
    "mirror:refresh": "bun dist/cli/mirror-refresh.js",
    "mirror:verify": "bun dist/cli/mirror-verify.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "congress",
    "congress-gov",
    "legislation",
    "bills",
    "legislative-data",
    "typescript",
    "us-government",
    "bun",
    "stdio",
    "streamable-http"
  ],
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "homepage": "https://github.com/cyanheads/congressgov-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/congressgov-mcp-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/congressgov-mcp-server.git"
  },
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.13.22",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.12.0",
    "node-cron": "^4.6.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "@types/node": "^26.6.6",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.14",
    "tsc-alias": "^1.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
